# ==============================================================================
# GarageFlow Environment Configuration Template
# Copy this file to .env and replace placeholders with real deployment secrets.
# NEVER commit .env or expose actual secret keys.
# ==============================================================================

# Server Network Configuration
# Port on which the Express.js HTTP server listens
PORT=5000

# Application Runtime Environment ('development' | 'production' | 'test')
NODE_ENV=production

# JWT Authentication Secret
# High-entropy cryptographically random string used to sign and verify JSON Web Tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_character_hex_random_secret_for_production

# CORS Allowed Origin
# Restrict client origin in production (e.g., https://your-domain.com)
# Leave blank or set to '*' only in development
CORS_ORIGIN=*

# InsForge Cloud Backend Configuration
# Project URL endpoint for InsForge BaaS (PostgreSQL + Auth + Storage)
INSFORGE_URL=https://your-project-id.us-east.insforge.app

# InsForge Public Anonymous Key (safe for public/client operations if needed)
INSFORGE_ANON_KEY=anon_replace_with_your_insforge_public_anon_key

# InsForge Privileged Service Role / API Key
# Strictly server-side secret with administrative database access. NEVER expose to browser.
INSFORGE_API_KEY=ik_replace_with_your_insforge_privileged_service_key
